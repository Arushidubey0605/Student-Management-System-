## 🗄 Database Setup
```sql
CREATE DATABASE studentdb;
USE studentdb;

CREATE TABLE users (
  username VARCHAR(50),
  password VARCHAR(50),
  role VARCHAR(20)
);

INSERT INTO users VALUES
('admin','admin','ADMIN'),
('student','student','STUDENT');

CREATE TABLE students (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100),
  email VARCHAR(100),
  course VARCHAR(50)
);
